DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civitas_ai
TESTING=false

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-production-secret

# AI provider selection: mock, openai, gemini, ollama, huggingface, azure
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
HF_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Container startup
PORT=8000
RUN_MIGRATIONS=true
